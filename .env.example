# Public site URL, used for canonical URLs, sitemap, RSS and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). Create a key at https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Rate limiting for the contact endpoint (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (optional).
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Cloudflare Turnstile (optional, deferred past v1).
TURNSTILE_SECRET_KEY=
